<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{51A2DE08-6CF9-4580-A28F-1DE3CE111361}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DroidFinestra</RootNamespace>
    <AssemblyName>DroidFinestra</AssemblyName>
    <!-- .NET Framework 4.0, built with VS 2022 MSBuild (Finestra's csproj, retargeted). 4.0 runs on the 4.5.1 that
         Windows RT 8.1 ships in-box, so nothing needs installing on a Surface RT. The compiler builds against the
         v4.0 reference assemblies, so an API newer than 4.0 is a BUILD error here, not a crash on the device. -->
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <TargetFrameworkProfile />
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- ONE universal MSIL assembly, as Finestra: AnyCPU runs native ARM32 on Windows RT 8.1 / Win10 ARM32 and
         natively on x86/x64. Prefer32Bit does not exist below .NET 4.5, so it is off; this launcher loads no
         native DLL, so 64-bit on x64 is fine. Deploying to ARM = copying this exact .exe. NO separate ARM build. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- C# 7.3 as Finestra: compiler-only features, nothing that needs a runtime type 4.0 lacks (no ValueTuple,
         no async/await). -->
    <LangVersion>7.3</LangVersion>
    <!-- Source files are UTF-8 (no BOM); read them as UTF-8 so —, …, · in string literals survive. -->
    <CodePage>65001</CodePage>
    <!-- The exe's own icon: Hamed's DroidFinestra icon (16..256), at the repo root as Finestra keeps Finestra.ico. It is also
         embedded below so forms + the tray NotifyIcon load every size at runtime (Finestra's pattern). -->
    <ApplicationIcon>..\DroidFinestra.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
