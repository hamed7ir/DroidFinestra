    <!-- Roboto, private-loaded at runtime (RT-safe, nothing to install). Explicit LogicalNames so the resource
         names do not depend on the namespace. -->
    <EmbeddedResource Include="Fonts\Roboto-Regular.ttf"><LogicalName>app.fonts.Roboto-Regular.ttf</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Fonts\Roboto-Medium.ttf"><LogicalName>app.fonts.Roboto-Medium.ttf</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Fonts\Roboto-Bold.ttf"><LogicalName>app.fonts.Roboto-Bold.ttf</LogicalName></EmbeddedResource>
    <!-- The full multi-size app icon, embedded so ThemedChrome loads ALL sizes for form icons + the tray icon. -->
